# Connection string directa a Supabase (NO la pooled, la directa/transactional).
# Se usa unicamente para `drizzle-kit generate` y `drizzle-kit migrate`.
# Formato:
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@host:port/database
