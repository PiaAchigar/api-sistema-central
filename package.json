{
  "name": "piubella-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Backend del facturador Piubella sobre Cloudflare Workers + Hyperdrive + Drizzle",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db",
    "db:psql": "docker compose exec db psql -U piubella -d piubella",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.2",
    "@types/qrcode-generator": "^0.0.16",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "jose": "^6.2.3",
    "postgres": "^3.4.5",
    "qrcode-generator": "^2.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.101.0"
  }
}
